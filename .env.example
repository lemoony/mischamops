# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird nicht ins Git-Repository übernommen.

# Aus dem Spotify-Developer-Dashboard (deine App → Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Link zu deiner Playlist (Spotify → Teilen → Link kopieren).
# Muss dem Spotify-Account gehören, mit dem du dich bei --login anmeldest.
SPOTIFY_PLAYLIST=https://open.spotify.com/playlist/...

# Nur ändern, wenn du im Dashboard eine andere Redirect-URI eingetragen hast
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
